# JudgeForge API origin. The video showed http://127.0.0.1:8000 for the backend author's machine.
# Set the origin reachable from the browser that opens this frontend; never assume that loopback
# on a hosted Preview points to your backend. Leave blank only if your local server reverse-proxies /api.
NEXT_PUBLIC_API_BASE_URL=

# Optional synthetic business records for development. This does NOT create a user or bypass login;
# real JWT login and /api/auth/me role resolution are still required. Default off.
NEXT_PUBLIC_FIXTURE_DATA=0
